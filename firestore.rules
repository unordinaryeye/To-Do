rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 레거시(v2) 동기화 문서. 새 앱은 읽어서 이관만 하고 더 이상 쓰지 않는다.
    match /sync/{code} {
      allow read: if isCode(code);
      allow write: if isCode(code);
    }

    // v3 워크스페이스. 코드(6자리)를 아는 기기만 접근한다는 현재 모델을 유지한다.
    match /workspaces/{code} {
      allow read, write: if isCode(code);
      match /data/{doc} {
        allow read, write: if isCode(code) && validDoc(doc);
      }
    }

    function isCode(code) {
      return code.matches('^[A-Z2-9]{6}$');
    }

    function validDoc(doc) {
      return doc == 'habits' || doc.matches('^(todos|checks)-[0-9]{4}-[0-9]{2}$');
    }
  }
}
